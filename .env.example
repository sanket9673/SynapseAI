# AI Provider Selection: "groq" | "openai" | "mock"
AI_PROVIDER=mock

# Groq API Configuration (Fast Inference - https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI API Configuration (Secondary Fallback - https://platform.openai.com)
OPENAI_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
